# ==============================================================================
# Blinkist Clone - Production Environment Template
# ==============================================================================
# Copy this file to .env on your production host and populate with actual credentials:
#   cp .env.production.example .env
#   chmod 600 .env
# ==============================================================================

# ── 1. General & Security ─────────────────────────────────────────────────────
DEBUG=False
# Generate a cryptographically secure key: python -c 'import secrets; print(secrets.token_urlsafe(50))'
SECRET_KEY=generate-a-strong-secret-key-at-least-50-characters-long
# Comma-separated list of fully qualified domain names and hostnames
ALLOWED_HOSTS=yourdomain.com,api.yourdomain.com,localhost,127.0.0.1,backend,web,nginx
DOMAIN=yourdomain.com

# ── 2. Database (PostgreSQL 16) ───────────────────────────────────────────────
POSTGRES_DB=blinkist_prod_db
POSTGRES_USER=blinkist_prod_user
# Use a strong random password
POSTGRES_PASSWORD=replace_with_strong_random_db_password_here
# If running outside docker compose, specify full connection URI:
# DATABASE_URL=postgresql://blinkist_prod_user:password@host:5432/blinkist_prod_db

# ── 3. Redis Cache & Celery Task Broker ───────────────────────────────────────
REDIS_PASSWORD=replace_with_strong_random_redis_password_here
# Celery worker and broker use this URL:
# REDIS_URL=redis://:replace_with_strong_random_redis_password_here@redis:6379/1

# ── 4. Web Frontend (Next.js 16) ──────────────────────────────────────────────
NODE_ENV=production
NEXT_PUBLIC_API_URL=https://yourdomain.com/api/v1
PORT=80

# ── 5. CORS & CSRF Settings ───────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://yourdomain.com,http://localhost:3000,http://localhost
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://api.yourdomain.com

# ── 6. AI Ingestion & "Ask the Book" Gemini Pipeline ──────────────────────────
# Required for automated book summarization, key takeaway generation, and "Ask the Book"
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-2.5-flash
GEMINI_REQUEST_TIMEOUT_SECONDS=45

# Optional OpenAI / Pinecone vector recommendations (falls back to Gemini + local text)
OPENAI_API_KEY=
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX_NAME=blinkist-clone

# ── 7. Payment Processing & Subscription Monetization ─────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Regional Payment Gateway (SSLCommerz)
SUBSCRIPTION_PRICE_BDT=149.0
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=False

# ── 8. Push Notifications (FCM) ───────────────────────────────────────────────
# Optional: path to Firebase service account JSON for mobile push dispatches
FIREBASE_CREDENTIALS_PATH=

# ── 9. Object Storage (Optional S3/Cloud Storage) ──────────────────────────────
# Leave blank to use persistent Docker volume storage (/app/media)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1

# ── 10. Sentry APM & Real-Time Error Tracking ────────────────────────────────
# Backend & Celery Sentry DSN (e.g. https://<key>@<org>.ingest.sentry.io/<project>)
SENTRY_DSN=
# Frontend Web Sentry DSN
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.25
SENTRY_PROFILES_SAMPLE_RATE=0.1
SENTRY_RELEASE=blinkist-backend@1.0.0

# ── 11. Prometheus & Grafana APM Metrics ─────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_strong_grafana_password_here

